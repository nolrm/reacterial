{
  "name": "reacterial-monorepo",
  "description": "Reacterial Monorepo - Build multiple apps with shared components. Includes admin dashboard, UI library, auth, and theme packages.",
  "author": "Marlon M",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @reacterial/admin dev",
    "dev:all": "pnpm --parallel dev",
    "build": "pnpm --recursive build",
    "build:admin": "pnpm --filter @reacterial/admin build",
    "start": "pnpm --filter @reacterial/admin start",
    "lint": "pnpm --recursive lint",
    "format": "prettier --write \"**/*.{js,ts,tsx,vue,css}\"",
    "test": "pnpm --recursive test",
    "test:ci": "pnpm --recursive test:ci",
    "clean": "pnpm --recursive exec rm -rf node_modules .next dist",
    "type-check": "pnpm --recursive type-check"
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^8",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "typescript": "5.4.x"
  }
}
